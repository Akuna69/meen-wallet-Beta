<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        tools:viewBindingIgnore="true"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:meen="http://schemas.android.com/apk/res-auto"
        android:id="@+id/scan_qr_linear_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <io.meen.apollo.presentation.ui.view.MeenHeader
            android:id="@+id/scan_qr_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            meen:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0px"
            meen:layout_constraintBottom_toBottomOf="parent"
            meen:layout_constraintTop_toBottomOf="@id/scan_qr_header">

        <io.meen.apollo.presentation.ui.view.MeenEmptyScreen
                android:id="@+id/empty_screen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                meen:action="@string/grant_camera_permission_button"
                meen:icon="@drawable/enable_camera"
                meen:subtitle="@string/camera_permission_request"
                meen:title="@string/camera_permission_request_title" />

        <FrameLayout
                android:id="@+id/scan_qr_frame_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black" />

        <me.dm7.barcodescanner.zxing.ZXingScannerView
                android:id="@+id/scan_qr_scanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <TextView
                android:id="@+id/scan_qr_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:layout_marginStart="50dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="50dp"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="5dp"
                android:text="@string/qr_scanner_subtitle"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:visibility="visible" />

    </FrameLayout>

    <io.meen.apollo.presentation.ui.view.MeenUriPaster
            android:id="@+id/uri_paster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            meen:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            tools:visibility="visible" />

    <include
            android:id="@+id/paste_from_clipboard"
            layout="@layout/view_paste_from_clipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            meen:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
